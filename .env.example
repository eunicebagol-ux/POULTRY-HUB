# POULTRY HUB — Environment Variables Example
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must NEVER be committed.

# ─── Supabase ────────────────────────────────────────────────────────────────

# Your Supabase project URL (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — safe for browser bundle. Use the "publishable" type key
# from the Supabase dashboard (API Keys → publishable), NOT the service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Service-role key — SERVER-SIDE ONLY.
# NEVER prefix with NEXT_PUBLIC_.
# NEVER expose in client components, browser bundles, or public logs.
# Used only in src/lib/supabase/admin.ts and the Clerk webhook handler.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Application ─────────────────────────────────────────────────────────────

# The full public URL of this application (safe for browser bundle).
# Used for redirects, OG images, and canonical URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Clerk handles all user authentication and identity.
# Supabase uses Clerk's JWT (auth.jwt() ->> 'sub') for RLS and RPCs.

# Publishable key — safe for browser bundle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Secret key — SERVER-SIDE ONLY. Never expose.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Webhook signing secret — SERVER-SIDE ONLY. Used to verify Clerk webhook signatures.
# Obtain from the Clerk Dashboard → Webhooks → your endpoint → Signing Secret.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxx

# Clerk redirect URLs — safe for browser bundle.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
